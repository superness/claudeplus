{
  "id": "product-research-v1",
  "name": "Product Research & Recommendation",
  "description": "Informed product purchase research with skeptical review - produces top 3 recommendations backed by real research",
  "version": "1.0.0",
  "category": "research",
  "stages": [
    {
      "id": "gather_requirements",
      "name": "Gather Requirements",
      "type": "analyzer",
      "agent": "product_requirements_analyst",
      "description": "Extract and clarify what the user is looking for in a product",
      "decisions": [
        {"choice": "requirements_gathered", "description": "Requirements understood, ready to research"}
      ]
    },
    {
      "id": "research_products",
      "name": "Research Products",
      "type": "researcher",
      "agent": "product_researcher",
      "description": "Search for products matching requirements, gather reviews and pricing",
      "inputs": ["gather_requirements"],
      "decisions": [
        {"choice": "research_complete", "description": "Found candidate products with reviews and pricing"}
      ]
    },
    {
      "id": "skeptical_review",
      "name": "Skeptical Review",
      "type": "adversary",
      "agent": "product_skeptic",
      "description": "Challenge findings, identify marketing hype, find hidden issues",
      "inputs": ["gather_requirements", "research_products"],
      "decisions": [
        {"choice": "critique_complete", "description": "All products scrutinized, concerns documented"},
        {"choice": "needs_more_research", "description": "Significant gaps found, need more research"}
      ]
    },
    {
      "id": "synthesize_recommendation",
      "name": "Final Recommendation",
      "type": "synthesizer",
      "agent": "product_recommender",
      "description": "Combine research and critique into top 3 purchase recommendations",
      "inputs": ["gather_requirements", "research_products", "skeptical_review"],
      "decisions": [
        {"choice": "recommendation_complete", "description": "Top 3 recommendations ready with justification"}
      ]
    }
  ],
  "flow": {
    "type": "conditional",
    "description": "Linear flow with optional research loop if skeptic finds gaps",
    "connections": [
      {
        "from": "gather_requirements",
        "to": "research_products",
        "condition": "requirements_gathered",
        "description": "Requirements clear, begin product research"
      },
      {
        "from": "research_products",
        "to": "skeptical_review",
        "condition": "research_complete",
        "description": "Products found, submit to skeptical review"
      },
      {
        "from": "skeptical_review",
        "to": "synthesize_recommendation",
        "condition": "critique_complete",
        "description": "Critique done, synthesize final recommendation"
      },
      {
        "from": "skeptical_review",
        "to": "research_products",
        "condition": "needs_more_research",
        "description": "Gaps found, researcher needs to find more options"
      },
      {
        "from": "synthesize_recommendation",
        "to": null,
        "condition": "recommendation_complete",
        "description": "Top 3 recommendations delivered - PIPELINE ENDS"
      }
    ]
  },
  "metadata": {
    "tags": ["product-research", "shopping", "recommendations", "consumer"],
    "author": "Claude Plus Development System",
    "usesWebSearch": true
  }
}
