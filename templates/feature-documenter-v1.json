{
  "id": "feature-documenter-v1",
  "name": "Feature Documenter Pipeline V1",
  "description": "Comprehensive feature documentation workflow that analyzes a master features document, explores the codebase, extracts actual implementations, and generates detailed feature documentation for a specific section",
  "version": "1.0.0",
  "category": "documentation",
  "stages": [
    {
      "id": "section_analysis",
      "name": "Section Analysis",
      "type": "analyzer",
      "agent": "section_analyzer",
      "description": "Parse the master features document and identify the requested section, extracting current content and understanding scope",
      "decisions": [
        {"choice": "section_found", "description": "Section identified with current content extracted"},
        {"choice": "section_not_found", "description": "Requested section does not exist in master document"},
        {"choice": "ambiguous_section", "description": "Multiple sections match, need clarification"}
      ]
    },
    {
      "id": "codebase_exploration",
      "name": "Codebase Exploration",
      "type": "explorer",
      "agent": "codebase_explorer",
      "description": "Search the codebase for all files, functions, structs, and modules related to the feature section",
      "inputs": ["section_analysis"],
      "decisions": [
        {"choice": "exploration_complete", "description": "All relevant code locations identified and catalogued"},
        {"choice": "no_implementation", "description": "No implementation found for this feature area"}
      ]
    },
    {
      "id": "feature_extraction",
      "name": "Feature Extraction",
      "type": "extractor",
      "agent": "feature_extractor",
      "description": "Deep dive into identified code to extract actual features, APIs, data structures, configuration options, and behaviors",
      "inputs": ["section_analysis", "codebase_exploration"],
      "decisions": [
        {"choice": "extraction_complete", "description": "All features extracted with technical details"},
        {"choice": "needs_deeper_analysis", "description": "Complex code requires additional analysis pass"}
      ]
    },
    {
      "id": "gap_analysis",
      "name": "Gap Analysis",
      "type": "analyzer",
      "agent": "gap_analyzer",
      "description": "Compare documented features vs implemented features, identify gaps, undocumented functionality, and areas needing attention",
      "inputs": ["section_analysis", "feature_extraction"],
      "decisions": [
        {"choice": "gaps_identified", "description": "Gap analysis complete with recommendations"},
        {"choice": "no_gaps", "description": "Documentation matches implementation"}
      ]
    },
    {
      "id": "document_writing",
      "name": "Document Writing",
      "type": "writer",
      "agent": "document_writer",
      "description": "Write comprehensive feature documentation including overview, technical details, APIs, configuration, examples, and future work",
      "inputs": ["section_analysis", "feature_extraction", "gap_analysis"],
      "decisions": [
        {"choice": "document_complete", "description": "Feature documentation written successfully"},
        {"choice": "needs_revision", "description": "Document needs structural changes"}
      ]
    },
    {
      "id": "quality_review",
      "name": "Quality Review",
      "type": "reviewer",
      "agent": "feature_doc_reviewer",
      "description": "Review the generated documentation for completeness, accuracy, clarity, and actionability",
      "inputs": ["section_analysis", "feature_extraction", "document_writing"],
      "decisions": [
        {"choice": "APPROVED", "description": "Documentation meets quality standards"},
        {"choice": "NEEDS_REVISION", "description": "Documentation needs improvements"},
        {"choice": "NEEDS_MORE_RESEARCH", "description": "Missing critical information, need more exploration"}
      ]
    }
  ],
  "flow": {
    "type": "conditional",
    "description": "Feature documentation workflow with quality gates and revision loops",
    "connections": [
      {
        "from": "section_analysis",
        "to": "codebase_exploration",
        "condition": "section_found",
        "description": "Section found, explore codebase for implementations"
      },
      {
        "from": "section_analysis",
        "to": null,
        "condition": "section_not_found",
        "description": "Section not found - PIPELINE ENDS"
      },
      {
        "from": "section_analysis",
        "to": null,
        "condition": "ambiguous_section",
        "description": "Ambiguous section - PIPELINE ENDS with clarification request"
      },
      {
        "from": "codebase_exploration",
        "to": "feature_extraction",
        "condition": "exploration_complete",
        "description": "Code locations found, extract features"
      },
      {
        "from": "codebase_exploration",
        "to": "document_writing",
        "condition": "no_implementation",
        "description": "No implementation yet, document planned features"
      },
      {
        "from": "feature_extraction",
        "to": "gap_analysis",
        "condition": "extraction_complete",
        "description": "Features extracted, analyze documentation gaps"
      },
      {
        "from": "feature_extraction",
        "to": "feature_extraction",
        "condition": "needs_deeper_analysis",
        "description": "Complex code, do another extraction pass"
      },
      {
        "from": "gap_analysis",
        "to": "document_writing",
        "condition": "gaps_identified",
        "description": "Gaps identified, write comprehensive documentation"
      },
      {
        "from": "gap_analysis",
        "to": "document_writing",
        "condition": "no_gaps",
        "description": "No gaps, write documentation"
      },
      {
        "from": "document_writing",
        "to": "quality_review",
        "condition": "document_complete",
        "description": "Document written, review quality"
      },
      {
        "from": "document_writing",
        "to": "document_writing",
        "condition": "needs_revision",
        "description": "Structural issues, revise document"
      },
      {
        "from": "quality_review",
        "to": null,
        "condition": "APPROVED",
        "description": "Documentation approved - PIPELINE ENDS"
      },
      {
        "from": "quality_review",
        "to": "document_writing",
        "condition": "NEEDS_REVISION",
        "description": "Quality issues, revise document"
      },
      {
        "from": "quality_review",
        "to": "codebase_exploration",
        "condition": "NEEDS_MORE_RESEARCH",
        "description": "Missing information, explore codebase again"
      }
    ],
    "maxIterations": {
      "feature_extraction": 3,
      "document_writing": 2,
      "quality_review": 2
    }
  },
  "inputs": {
    "required": ["docs/MASTER_FEATURES.md"],
    "context": {
      "section_name": "The section name to document (e.g., 'Identity & Keys', 'Block System', 'RPC API')",
      "project_root": "Root directory of the project to analyze"
    }
  },
  "outputs": {
    "primary": "docs/features/{section_name}_FEATURE_DOC.md",
    "secondary": ["exploration_report.md", "gap_analysis.md"]
  },
  "metadata": {
    "tags": ["documentation", "features", "analysis", "codebase"],
    "author": "Claude Plus Development System",
    "estimatedDuration": "15-30 minutes depending on section complexity"
  }
}
