{
  "id": "outstanding-implementer-v1",
  "name": "Outstanding Issues Implementation Pipeline V1",
  "description": "Implements outstanding action items from area owner reviews with pre-approved decisions. Processes issues by priority, makes code changes, and validates.",
  "version": "1.0.0",
  "category": "implementation",
  "stages": [
    {
      "id": "issue_loader",
      "name": "Issue Loader",
      "type": "analyzer",
      "agent": "issue_loader",
      "description": "Load the specific issue details and implementation plan from OUTSTANDING_ACTIONS.md",
      "decisions": [
        {"choice": "issue_found", "description": "Issue details loaded successfully"},
        {"choice": "issue_not_found", "description": "Issue ID not found in document"}
      ]
    },
    {
      "id": "context_gatherer",
      "name": "Context Gatherer",
      "type": "analyzer",
      "agent": "codebase_analyzer",
      "description": "Read relevant source files and understand existing patterns",
      "inputs": ["issue_loader"],
      "decisions": [
        {"choice": "context_ready", "description": "All relevant files read and understood"},
        {"choice": "files_missing", "description": "Some referenced files don't exist"}
      ]
    },
    {
      "id": "implementer",
      "name": "Implementation",
      "type": "implementer",
      "agent": "code_implementer",
      "description": "Implement the fix following existing patterns and pre-approved decisions",
      "inputs": ["issue_loader", "context_gatherer"],
      "decisions": [
        {"choice": "implemented", "description": "Changes implemented successfully"},
        {"choice": "blocked", "description": "Implementation blocked - needs clarification"},
        {"choice": "partial", "description": "Partially implemented - some parts need manual work"}
      ]
    },
    {
      "id": "validator",
      "name": "Validation",
      "type": "validator",
      "agent": "change_validator",
      "description": "Validate changes compile and pass basic tests",
      "inputs": ["implementer"],
      "decisions": [
        {"choice": "valid", "description": "All validations passed"},
        {"choice": "compile_error", "description": "Code doesn't compile"},
        {"choice": "test_failure", "description": "Tests fail"}
      ]
    },
    {
      "id": "documenter",
      "name": "Documentation",
      "type": "synthesis",
      "agent": "change_documenter",
      "description": "Document all changes made for review",
      "inputs": ["implementer", "validator"],
      "decisions": [
        {"choice": "documented", "description": "Changes documented"},
        {"choice": "rollback", "description": "Changes rolled back due to validation failure"}
      ]
    }
  ],
  "flow": {
    "type": "sequential",
    "connections": [
      {"from": "issue_loader", "to": "context_gatherer", "condition": "issue_found"},
      {"from": "issue_loader", "to": null, "condition": "issue_not_found"},
      {"from": "context_gatherer", "to": "implementer", "condition": "context_ready"},
      {"from": "context_gatherer", "to": "implementer", "condition": "files_missing"},
      {"from": "implementer", "to": "validator", "condition": "implemented"},
      {"from": "implementer", "to": "documenter", "condition": "blocked"},
      {"from": "implementer", "to": "validator", "condition": "partial"},
      {"from": "validator", "to": "documenter", "condition": "valid"},
      {"from": "validator", "to": "documenter", "condition": "compile_error"},
      {"from": "validator", "to": "documenter", "condition": "test_failure"},
      {"from": "documenter", "to": null, "condition": "documented"},
      {"from": "documenter", "to": null, "condition": "rollback"}
    ]
  },
  "inputs": {
    "required": ["issue_id"],
    "context": {
      "issue_id": "The issue ID (e.g., C-BLOCK-1, H-DHT-2)",
      "decisions_file": "Path to IMPLEMENTATION_DECISIONS.md with pre-approved choices"
    }
  },
  "outputs": {
    "primary": "docs/implementations/{issue_id}_IMPL_LOG.md"
  },
  "metadata": {
    "tags": ["implementation", "fix", "outstanding"],
    "author": "Claude Plus Development System",
    "estimatedDuration": "15-45 minutes per issue"
  }
}
