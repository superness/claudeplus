{
  "id": "area-owner-v1",
  "name": "Area Owner Review Pipeline V1",
  "description": "Comprehensive feature review from multiple expert perspectives: functionality, performance, vision alignment, user experience, accessibility, and quality. Produces actionable recommendations for area owners.",
  "version": "1.0.0",
  "category": "review",
  "stages": [
    {
      "id": "feature_context",
      "name": "Feature Context Loading",
      "type": "analyzer",
      "agent": "feature_context_loader",
      "description": "Load and understand the feature document, extract key information for reviewers",
      "decisions": [
        {"choice": "context_loaded", "description": "Feature context extracted successfully"},
        {"choice": "invalid_document", "description": "Not a valid feature document"}
      ]
    },
    {
      "id": "functionality_review",
      "name": "Functionality Review",
      "type": "reviewer",
      "agent": "functionality_reviewer",
      "description": "Review feature completeness, correctness, and implementation quality",
      "inputs": ["feature_context"],
      "decisions": [
        {"choice": "review_complete", "description": "Functionality review complete"}
      ]
    },
    {
      "id": "performance_review",
      "name": "Performance Review",
      "type": "reviewer",
      "agent": "performance_reviewer",
      "description": "Analyze performance implications, scalability, and optimization opportunities",
      "inputs": ["feature_context"],
      "decisions": [
        {"choice": "review_complete", "description": "Performance review complete"}
      ]
    },
    {
      "id": "vision_review",
      "name": "Vision & Spec Alignment Review",
      "type": "reviewer",
      "agent": "feature_vision_reviewer",
      "description": "Evaluate alignment with product vision, specifications, and architectural principles",
      "inputs": ["feature_context"],
      "decisions": [
        {"choice": "review_complete", "description": "Vision alignment review complete"}
      ]
    },
    {
      "id": "ux_review",
      "name": "User Experience Review",
      "type": "reviewer",
      "agent": "ux_reviewer",
      "description": "Assess user experience, usability, and interaction design",
      "inputs": ["feature_context"],
      "decisions": [
        {"choice": "review_complete", "description": "UX review complete"}
      ]
    },
    {
      "id": "accessibility_review",
      "name": "Accessibility Review",
      "type": "reviewer",
      "agent": "accessibility_reviewer",
      "description": "Evaluate accessibility compliance, inclusive design, and assistive technology support",
      "inputs": ["feature_context"],
      "decisions": [
        {"choice": "review_complete", "description": "Accessibility review complete"}
      ]
    },
    {
      "id": "quality_review",
      "name": "Quality & Reliability Review",
      "type": "reviewer",
      "agent": "quality_reliability_reviewer",
      "description": "Assess code quality, test coverage, error handling, and reliability",
      "inputs": ["feature_context"],
      "decisions": [
        {"choice": "review_complete", "description": "Quality review complete"}
      ]
    },
    {
      "id": "security_review",
      "name": "Security Review",
      "type": "reviewer",
      "agent": "security_reviewer",
      "description": "Identify security concerns, attack vectors, and cryptographic correctness",
      "inputs": ["feature_context"],
      "decisions": [
        {"choice": "review_complete", "description": "Security review complete"}
      ]
    },
    {
      "id": "synthesis",
      "name": "Area Owner Synthesis",
      "type": "synthesis",
      "agent": "area_owner_synthesizer",
      "description": "Synthesize all reviews into prioritized action items and recommendations",
      "inputs": ["feature_context", "functionality_review", "performance_review", "vision_review", "ux_review", "accessibility_review", "quality_review", "security_review"],
      "decisions": [
        {"choice": "synthesis_complete", "description": "Synthesis complete with action items"},
        {"choice": "critical_issues", "description": "Critical issues require immediate attention"}
      ]
    }
  ],
  "flow": {
    "type": "parallel-then-synthesis",
    "description": "Run all reviews in sequence, then synthesize findings",
    "connections": [
      {
        "from": "feature_context",
        "to": "functionality_review",
        "condition": "context_loaded",
        "description": "Context loaded, start functionality review"
      },
      {
        "from": "feature_context",
        "to": null,
        "condition": "invalid_document",
        "description": "Invalid document - PIPELINE ENDS"
      },
      {
        "from": "functionality_review",
        "to": "performance_review",
        "condition": "review_complete",
        "description": "Functionality done, start performance review"
      },
      {
        "from": "performance_review",
        "to": "vision_review",
        "condition": "review_complete",
        "description": "Performance done, start vision review"
      },
      {
        "from": "vision_review",
        "to": "ux_review",
        "condition": "review_complete",
        "description": "Vision done, start UX review"
      },
      {
        "from": "ux_review",
        "to": "accessibility_review",
        "condition": "review_complete",
        "description": "UX done, start accessibility review"
      },
      {
        "from": "accessibility_review",
        "to": "quality_review",
        "condition": "review_complete",
        "description": "Accessibility done, start quality review"
      },
      {
        "from": "quality_review",
        "to": "security_review",
        "condition": "review_complete",
        "description": "Quality done, start security review"
      },
      {
        "from": "security_review",
        "to": "synthesis",
        "condition": "review_complete",
        "description": "All reviews done, synthesize findings"
      },
      {
        "from": "synthesis",
        "to": null,
        "condition": "synthesis_complete",
        "description": "Synthesis complete - PIPELINE ENDS"
      },
      {
        "from": "synthesis",
        "to": null,
        "condition": "critical_issues",
        "description": "Critical issues flagged - PIPELINE ENDS"
      }
    ]
  },
  "inputs": {
    "required": ["feature_document_path"],
    "context": {
      "feature_name": "Name of the feature being reviewed",
      "feature_document_path": "Path to the feature documentation"
    }
  },
  "outputs": {
    "primary": "docs/reviews/{feature_name}_AREA_OWNER_REVIEW.md",
    "secondary": ["individual_reviews/"]
  },
  "metadata": {
    "tags": ["review", "area-owner", "quality", "comprehensive"],
    "author": "Claude Plus Development System",
    "estimatedDuration": "15-25 minutes per feature"
  }
}
