{
  "id": "component-build-v1",
  "name": "Component Builder",
  "description": "Builds a single component with proper validation - creates code, tests, and verifies all deliverables exist before marking complete",
  "version": "1.0.0",
  "category": "build",
  "stages": [
    {
      "id": "plan_implementation",
      "name": "Plan Implementation",
      "type": "planner",
      "agent": "task_planner",
      "description": "Plan implementation for the component including all deliverables and test files",
      "decisions": [
        {"choice": "PLAN_READY", "description": "Implementation plan is ready"}
      ]
    },
    {
      "id": "implement_component",
      "name": "Implement Component",
      "type": "executor",
      "agent": "task_executor",
      "description": "Create the component code and ALL required test files",
      "inputs": ["plan_implementation"],
      "decisions": [
        {"choice": "IMPLEMENTATION_DONE", "description": "Code and tests written"}
      ]
    },
    {
      "id": "verify_deliverables",
      "name": "Verify Deliverables",
      "type": "validator",
      "agent": "deliverable_validator",
      "description": "Check that ALL deliverables and test files actually exist on disk",
      "inputs": ["plan_implementation", "implement_component"],
      "decisions": [
        {"choice": "ALL_FILES_EXIST", "description": "All deliverables and tests exist"},
        {"choice": "FILES_MISSING", "description": "Some files are missing - loop back"}
      ]
    },
    {
      "id": "run_tests",
      "name": "Run Tests",
      "type": "executor",
      "agent": "test_runner",
      "description": "Execute the test files and verify they pass",
      "inputs": ["verify_deliverables"],
      "decisions": [
        {"choice": "TESTS_PASS", "description": "All tests pass"},
        {"choice": "TESTS_FAIL", "description": "Tests failed - need fixes"}
      ]
    },
    {
      "id": "final_validation",
      "name": "Final Validation",
      "type": "validator",
      "agent": "proof_validator",
      "description": "Final check that component is complete and working",
      "inputs": ["run_tests"],
      "decisions": [
        {"choice": "COMPONENT_COMPLETE", "description": "Component fully built and tested"},
        {"choice": "NEEDS_FIXES", "description": "Issues found, retry implementation"}
      ]
    }
  ],
  "flow": {
    "type": "conditional",
    "description": "Plan -> Implement -> Verify Files -> Run Tests -> Validate (with loops back on failure)",
    "connections": [
      {
        "from": "plan_implementation",
        "to": "implement_component",
        "condition": "PLAN_READY"
      },
      {
        "from": "implement_component",
        "to": "verify_deliverables",
        "condition": "IMPLEMENTATION_DONE"
      },
      {
        "from": "verify_deliverables",
        "to": "run_tests",
        "condition": "ALL_FILES_EXIST"
      },
      {
        "from": "verify_deliverables",
        "to": "implement_component",
        "condition": "FILES_MISSING",
        "description": "Missing files - tell executor exactly what to create"
      },
      {
        "from": "run_tests",
        "to": "final_validation",
        "condition": "TESTS_PASS"
      },
      {
        "from": "run_tests",
        "to": "implement_component",
        "condition": "TESTS_FAIL",
        "description": "Tests failed - fix the code"
      },
      {
        "from": "final_validation",
        "to": null,
        "condition": "COMPONENT_COMPLETE"
      },
      {
        "from": "final_validation",
        "to": "implement_component",
        "condition": "NEEDS_FIXES"
      }
    ]
  },
  "metadata": {
    "author": "Claude Plus",
    "purpose": "Build system components with proper file validation"
  }
}
