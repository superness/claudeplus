{
  "id": "client-documenter-v1",
  "name": "Client Application Documenter Pipeline V1",
  "description": "Comprehensive documentation workflow for Swimchain UI client applications. Analyzes React/TypeScript codebase, extracts components, hooks, pages, and generates detailed feature documentation.",
  "version": "1.0.0",
  "category": "documentation",
  "stages": [
    {
      "id": "client_analysis",
      "name": "Client Analysis",
      "type": "analyzer",
      "agent": "client_analyzer",
      "description": "Analyze the client application structure, identify tech stack, entry points, and overall architecture",
      "decisions": [
        {"choice": "analysis_complete", "description": "Client structure analyzed successfully"},
        {"choice": "invalid_client", "description": "Not a valid client application"}
      ]
    },
    {
      "id": "component_extraction",
      "name": "Component Extraction",
      "type": "extractor",
      "agent": "component_extractor",
      "description": "Extract all React components, their props, state, and relationships",
      "inputs": ["client_analysis"],
      "decisions": [
        {"choice": "extraction_complete", "description": "All components extracted"},
        {"choice": "needs_deeper_analysis", "description": "Complex components need more analysis"}
      ]
    },
    {
      "id": "hooks_extraction",
      "name": "Hooks & State Extraction",
      "type": "extractor",
      "agent": "hooks_extractor",
      "description": "Extract custom hooks, context providers, and state management patterns",
      "inputs": ["client_analysis"],
      "decisions": [
        {"choice": "extraction_complete", "description": "All hooks and state patterns extracted"},
        {"choice": "needs_deeper_analysis", "description": "Complex state management needs more analysis"}
      ]
    },
    {
      "id": "feature_mapping",
      "name": "Feature Mapping",
      "type": "analyzer",
      "agent": "feature_mapper",
      "description": "Map UI features to their implementation, identify user flows and interactions",
      "inputs": ["client_analysis", "component_extraction", "hooks_extraction"],
      "decisions": [
        {"choice": "mapping_complete", "description": "All features mapped to implementation"},
        {"choice": "incomplete_features", "description": "Some features not fully implemented"}
      ]
    },
    {
      "id": "document_writing",
      "name": "Document Writing",
      "type": "writer",
      "agent": "client_doc_writer",
      "description": "Write comprehensive client documentation including architecture, components, features, and usage",
      "inputs": ["client_analysis", "component_extraction", "hooks_extraction", "feature_mapping"],
      "decisions": [
        {"choice": "document_complete", "description": "Client documentation written successfully"},
        {"choice": "needs_revision", "description": "Document needs structural changes"}
      ]
    },
    {
      "id": "quality_review",
      "name": "Quality Review",
      "type": "reviewer",
      "agent": "client_doc_reviewer",
      "description": "Review the generated documentation for completeness and accuracy",
      "inputs": ["client_analysis", "feature_mapping", "document_writing"],
      "decisions": [
        {"choice": "APPROVED", "description": "Documentation meets quality standards"},
        {"choice": "NEEDS_REVISION", "description": "Documentation needs improvements"},
        {"choice": "NEEDS_MORE_RESEARCH", "description": "Missing critical information"}
      ]
    }
  ],
  "flow": {
    "type": "conditional",
    "description": "Client documentation workflow with parallel extraction and quality gates",
    "connections": [
      {
        "from": "client_analysis",
        "to": "component_extraction",
        "condition": "analysis_complete",
        "description": "Client analyzed, extract components"
      },
      {
        "from": "client_analysis",
        "to": null,
        "condition": "invalid_client",
        "description": "Invalid client - PIPELINE ENDS"
      },
      {
        "from": "component_extraction",
        "to": "hooks_extraction",
        "condition": "extraction_complete",
        "description": "Components extracted, extract hooks"
      },
      {
        "from": "component_extraction",
        "to": "component_extraction",
        "condition": "needs_deeper_analysis",
        "description": "Complex components, analyze again"
      },
      {
        "from": "hooks_extraction",
        "to": "feature_mapping",
        "condition": "extraction_complete",
        "description": "Hooks extracted, map features"
      },
      {
        "from": "hooks_extraction",
        "to": "hooks_extraction",
        "condition": "needs_deeper_analysis",
        "description": "Complex state, analyze again"
      },
      {
        "from": "feature_mapping",
        "to": "document_writing",
        "condition": "mapping_complete",
        "description": "Features mapped, write documentation"
      },
      {
        "from": "feature_mapping",
        "to": "document_writing",
        "condition": "incomplete_features",
        "description": "Some features incomplete, document anyway"
      },
      {
        "from": "document_writing",
        "to": "quality_review",
        "condition": "document_complete",
        "description": "Document written, review quality"
      },
      {
        "from": "document_writing",
        "to": "document_writing",
        "condition": "needs_revision",
        "description": "Structural issues, revise"
      },
      {
        "from": "quality_review",
        "to": null,
        "condition": "APPROVED",
        "description": "Documentation approved - PIPELINE ENDS"
      },
      {
        "from": "quality_review",
        "to": "document_writing",
        "condition": "NEEDS_REVISION",
        "description": "Quality issues, revise"
      },
      {
        "from": "quality_review",
        "to": "component_extraction",
        "condition": "NEEDS_MORE_RESEARCH",
        "description": "Missing info, research more"
      }
    ],
    "maxIterations": {
      "component_extraction": 2,
      "hooks_extraction": 2,
      "document_writing": 2,
      "quality_review": 2
    }
  },
  "inputs": {
    "required": ["client_path"],
    "context": {
      "client_name": "Name of the client (e.g., 'forum-client')",
      "client_path": "Full path to the client directory"
    }
  },
  "outputs": {
    "primary": "docs/clients/{client_name}_CLIENT_DOC.md",
    "secondary": ["component_inventory.md", "hooks_inventory.md"]
  },
  "metadata": {
    "tags": ["documentation", "client", "react", "typescript", "ui"],
    "author": "Claude Plus Development System",
    "estimatedDuration": "10-20 minutes per client"
  }
}
