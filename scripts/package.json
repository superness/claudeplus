{
  "name": "claudeplus-scripts",
  "version": "1.0.0",
  "description": "Scripts for running Claude Plus pipelines",
  "type": "commonjs",
  "scripts": {
    "feature-docs": "node run-feature-docs.js",
    "feature-docs:retry": "node run-feature-docs.js --retry-failed",
    "feature-docs:list-failed": "node run-feature-docs.js --list-failed",
    "feature-docs:test": "node run-feature-docs.js --sections=\"Identity & Cryptography\" --concurrency=1",
    "client-docs": "node run-client-docs.js",
    "client-docs:retry": "node run-client-docs.js --retry-failed",
    "client-docs:list-failed": "node run-client-docs.js --list-failed",
    "client-docs:test": "node run-client-docs.js --clients=\"forum\" --concurrency=1"
  },
  "dependencies": {
    "ws": "^8.14.0"
  }
}
