{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://claudeplus.dev/schemas/memory-entry.schema.json",
  "title": "Memory Entry",
  "description": "Schema for Feature Owner System knowledge base entries",
  "type": "object",
  "required": ["entry_id", "timestamp", "memory_type", "owner_id", "content"],
  "properties": {
    "entry_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]+$",
      "minLength": 1,
      "description": "Unique identifier for this memory entry"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp when entry was created"
    },
    "memory_type": {
      "type": "string",
      "enum": ["short_term", "working", "long_term", "learned_pattern", "decision_history"],
      "description": "Type of memory"
    },
    "owner_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$",
      "description": "Agent ID that owns this memory"
    },
    "content": {
      "type": "object",
      "minProperties": 1,
      "description": "The actual memory content (structure varies by memory_type)"
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" },
      "default": [],
      "description": "Searchable tags for this memory"
    },
    "source": {
      "type": ["string", "null"],
      "default": null,
      "description": "Where this memory came from"
    },
    "expires_at": {
      "type": ["string", "null"],
      "format": "date-time",
      "default": null,
      "description": "ISO 8601 expiration timestamp (null = never expires)"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "default": 1.0,
      "description": "Confidence score for this memory (0-1)"
    },
    "related_entries": {
      "type": "array",
      "items": { "type": "string" },
      "default": [],
      "description": "IDs of related memory entries"
    },
    "session_id": {
      "type": ["string", "null"],
      "default": null,
      "description": "Session ID (required for short_term memories)"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "memory_type": { "const": "short_term" } }
      },
      "then": {
        "required": ["session_id"],
        "properties": {
          "session_id": { "type": "string", "minLength": 1 }
        }
      }
    },
    {
      "if": {
        "properties": { "memory_type": { "const": "learned_pattern" } }
      },
      "then": {
        "properties": {
          "content": {
            "type": "object",
            "required": ["pattern_name", "description", "triggers", "validation_count"],
            "properties": {
              "pattern_name": { "type": "string" },
              "description": { "type": "string" },
              "triggers": {
                "type": "array",
                "items": { "type": "string" },
                "minItems": 1
              },
              "validation_count": {
                "type": "integer",
                "minimum": 2
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "memory_type": { "const": "decision_history" } }
      },
      "then": {
        "properties": {
          "content": {
            "type": "object",
            "required": ["decision", "context", "outcome", "successful"],
            "properties": {
              "decision": { "type": "string" },
              "context": { "type": "string" },
              "outcome": { "type": "string" },
              "successful": { "type": "boolean" }
            }
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
