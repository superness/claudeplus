{
  "tool_id": "config_reader",
  "name": "Configuration Reader",
  "description": "Reads and parses configuration files in various formats",
  "operations": [
    {
      "name": "read",
      "description": "Read and parse a configuration file",
      "parameters": {
        "path": {
          "type": "string",
          "description": "Path to the config file",
          "required": true
        },
        "format": {
          "type": "string",
          "enum": ["json", "yaml", "toml", "ini"],
          "description": "File format (auto-detected if not specified)"
        }
      },
      "returns": {
        "type": "object",
        "description": "Parsed configuration object"
      }
    }
  ]
}
