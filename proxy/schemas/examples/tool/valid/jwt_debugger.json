{
  "tool_id": "jwt_debugger",
  "name": "JWT Debugger",
  "description": "Decodes and validates JWT tokens, extracts claims, and verifies signatures",
  "version": "1.2.0",
  "domain": "identity",
  "owner_access": ["identity_owner", "security_owner"],
  "operations": [
    {
      "name": "decode",
      "description": "Decode a JWT token without verification",
      "parameters": {
        "token": {
          "type": "string",
          "description": "The JWT token to decode",
          "required": true
        }
      },
      "returns": {
        "type": "object",
        "description": "Decoded token with header, payload, and signature"
      }
    },
    {
      "name": "verify",
      "description": "Verify a JWT token signature and expiration",
      "parameters": {
        "token": {
          "type": "string",
          "description": "The JWT token to verify",
          "required": true
        },
        "secret": {
          "type": "string",
          "description": "Secret or public key for verification",
          "required": true
        },
        "algorithms": {
          "type": "array",
          "description": "Allowed algorithms",
          "default": ["HS256", "RS256"]
        }
      },
      "returns": {
        "type": "object",
        "description": "Verification result with validity and payload"
      }
    },
    {
      "name": "extractClaims",
      "description": "Extract specific claims from a JWT",
      "parameters": {
        "token": {
          "type": "string",
          "required": true
        },
        "claims": {
          "type": "array",
          "description": "Claim names to extract",
          "default": ["sub", "exp", "iat"]
        }
      },
      "returns": {
        "type": "object",
        "description": "Extracted claims"
      }
    }
  ],
  "implementation": {
    "type": "builtin",
    "config": {
      "maxTokenLength": 10000
    }
  }
}
