{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://claudeplus.dev/schemas/fingerprint.schema.json",
  "title": "Complexity Fingerprint",
  "description": "Schema for the 6-dimensional complexity fingerprint model",
  "type": "object",
  "required": ["version", "timestamp", "task", "dimensions", "compositeScore", "scoreCategory", "recommendation"],
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+$",
      "description": "Schema version (e.g., '1.0')"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp when assessment was created"
    },
    "task": {
      "type": "string",
      "minLength": 10,
      "description": "Task description being assessed"
    },
    "dimensions": {
      "type": "object",
      "required": ["S_surfaceArea", "D_dependencyDepth", "U_uncertainty", "B_breadthOfExpertise", "I_integrationPoints", "T_testability"],
      "properties": {
        "S_surfaceArea": {
          "$ref": "#/definitions/dimension",
          "description": "Surface Area: number of files/components affected (weight: 1.0)"
        },
        "D_dependencyDepth": {
          "$ref": "#/definitions/dimension",
          "description": "Dependency Depth: how deep the dependency chain goes (weight: 1.5)"
        },
        "U_uncertainty": {
          "$ref": "#/definitions/dimension",
          "description": "Uncertainty: how much is unknown or ambiguous (weight: 1.5)"
        },
        "B_breadthOfExpertise": {
          "$ref": "#/definitions/dimension",
          "description": "Breadth of Expertise: number of different domains required (weight: 2.0)"
        },
        "I_integrationPoints": {
          "$ref": "#/definitions/dimension",
          "description": "Integration Points: external systems that must be coordinated (weight: 1.0)"
        },
        "T_testability": {
          "$ref": "#/definitions/dimension",
          "description": "Testability Complexity: difficulty of testing the changes (weight: 1.0)"
        }
      },
      "additionalProperties": false,
      "description": "The 6 complexity dimensions with scores and evidence"
    },
    "compositeScore": {
      "type": "number",
      "minimum": 8,
      "maximum": 40,
      "description": "Weighted composite score (S*1.0 + D*1.5 + U*1.5 + B*2.0 + I*1.0 + T*1.0)"
    },
    "scoreCategory": {
      "type": "string",
      "enum": ["SIMPLE", "MODERATE", "COMPLEX", "HIGHLY_COMPLEX", "EXTREME"],
      "description": "Category based on compositeScore ranges"
    },
    "recommendation": {
      "type": "string",
      "enum": ["PROCEED", "MONITOR", "ELEVATE"],
      "description": "Recommended action based on complexity assessment"
    },
    "decompositionPlan": {
      "type": ["object", "null"],
      "properties": {
        "subtasks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["description"],
            "properties": {
              "description": { "type": "string" },
              "estimatedComplexity": {
                "type": "string",
                "enum": ["SIMPLE", "MODERATE", "COMPLEX"]
              },
              "assignTo": { "type": "string" }
            }
          },
          "description": "Proposed subtask breakdown"
        },
        "rationale": {
          "type": "string",
          "description": "Why decomposition is recommended"
        }
      },
      "default": null,
      "description": "Decomposition plan if elevation is recommended"
    },
    "assessedBy": {
      "type": ["string", "null"],
      "default": null,
      "description": "Agent ID that performed this assessment"
    },
    "parentTaskId": {
      "type": ["string", "null"],
      "default": null,
      "description": "Link to parent task if this is a sub-task"
    }
  },
  "definitions": {
    "dimension": {
      "type": "object",
      "required": ["score", "evidence"],
      "properties": {
        "score": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5,
          "description": "Score from 1 (low) to 5 (high)"
        },
        "evidence": {
          "type": "object",
          "minProperties": 1,
          "description": "Evidence supporting this score"
        }
      }
    }
  },
  "additionalProperties": false
}
