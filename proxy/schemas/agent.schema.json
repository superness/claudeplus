{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://claudeplus.dev/schemas/agent.schema.json",
  "title": "Agent Definition",
  "description": "Schema for Feature Owner System agent definitions",
  "type": "object",
  "required": ["id", "name", "type", "domain", "systemPrompt", "tools", "decisions"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$",
      "description": "Unique agent identifier in snake_case format"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "Human-readable name for the agent"
    },
    "type": {
      "type": "string",
      "enum": ["orchestrator", "feature_owner", "ic"],
      "description": "Agent type: orchestrator (Product Maestro), feature_owner (domain expert), or ic (individual contributor)"
    },
    "domain": {
      "type": "object",
      "required": ["primary"],
      "properties": {
        "primary": {
          "type": "string",
          "minLength": 1,
          "description": "Primary domain responsibility"
        },
        "includes": {
          "type": "array",
          "items": { "type": "string" },
          "default": [],
          "description": "Specific areas included in this domain"
        },
        "excludes": {
          "type": "array",
          "items": { "type": "string" },
          "default": [],
          "description": "Specific areas explicitly excluded from this domain"
        }
      },
      "description": "Domain boundaries defining agent's area of responsibility"
    },
    "systemPrompt": {
      "type": "string",
      "minLength": 100,
      "description": "Full system prompt for the agent (minimum 100 characters)"
    },
    "tools": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1,
      "description": "List of tool IDs this agent can use"
    },
    "decisions": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1,
      "description": "Decision types this agent can make"
    },
    "description": {
      "type": "string",
      "default": "",
      "description": "Brief description of the agent's purpose"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "default": "1.0.0",
      "description": "Semantic version of the agent definition"
    },
    "capabilities": {
      "type": "array",
      "items": { "type": "string" },
      "default": [],
      "description": "Capability identifiers for this agent"
    },
    "knowledge": {
      "type": "object",
      "properties": {
        "codebase_paths": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Paths in codebase this agent should know"
        },
        "documentation": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Documentation references"
        },
        "external_resources": {
          "type": "array",
          "items": { "type": "string" },
          "description": "External resource URLs"
        }
      },
      "default": {},
      "description": "Knowledge base references for this agent"
    },
    "parameters": {
      "type": "object",
      "properties": {
        "temperature": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.7,
          "description": "LLM temperature setting"
        },
        "max_tokens": {
          "type": "integer",
          "minimum": 100,
          "default": 3000,
          "description": "Maximum tokens for responses"
        },
        "response_format": {
          "type": "string",
          "enum": ["conversational", "structured", "json"],
          "default": "conversational",
          "description": "Expected response format"
        }
      },
      "default": {
        "temperature": 0.7,
        "max_tokens": 3000,
        "response_format": "conversational"
      },
      "description": "LLM parameters for this agent"
    },
    "selfLearning": {
      "type": ["object", "null"],
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Whether self-learning is enabled"
        },
        "memory_types": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["learned_pattern", "decision_history"]
          },
          "description": "Types of memories this agent can create"
        },
        "validation_threshold": {
          "type": "integer",
          "minimum": 1,
          "description": "Number of validations before pattern is accepted"
        }
      },
      "default": null,
      "description": "Self-learning configuration for the agent"
    },
    "elevationCapability": {
      "type": ["object", "null"],
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Whether this agent can elevate complex tasks"
        },
        "threshold_score": {
          "type": "number",
          "minimum": 8,
          "maximum": 40,
          "description": "Complexity score threshold for elevation"
        },
        "target_agent_type": {
          "type": "string",
          "enum": ["orchestrator", "feature_owner"],
          "description": "Type of agent to elevate to"
        }
      },
      "default": null,
      "description": "Recursive scaling capability configuration"
    }
  },
  "additionalProperties": false
}
