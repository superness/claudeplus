{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://claudeplus.dev/schemas/teaching-request.schema.json",
  "title": "Teaching Request",
  "description": "Schema for new agent creation requests via the Teaching Protocol",
  "type": "object",
  "required": [
    "domain_name",
    "domain_description",
    "triggered_by",
    "domain_analysis",
    "knowledge_requirements",
    "tool_requirements",
    "decision_types",
    "validation_queries"
  ],
  "properties": {
    "domain_name": {
      "type": "string",
      "minLength": 2,
      "pattern": "^[A-Za-z][A-Za-z0-9 _-]*$",
      "description": "Name of the new domain (e.g., 'Accessibility')"
    },
    "domain_description": {
      "type": "string",
      "minLength": 20,
      "description": "Detailed description of what this domain covers"
    },
    "triggered_by": {
      "type": "string",
      "minLength": 10,
      "description": "What request or situation triggered this teaching request"
    },
    "domain_analysis": {
      "type": "object",
      "required": ["includes", "excludes"],
      "properties": {
        "includes": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1,
          "description": "Specific areas included in this domain"
        },
        "excludes": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Specific areas explicitly excluded"
        },
        "related_owners": {
          "type": "array",
          "items": { "type": "string" },
          "default": [],
          "description": "IDs of related Feature Owners"
        }
      },
      "description": "Analysis of domain boundaries"
    },
    "knowledge_requirements": {
      "type": "object",
      "properties": {
        "codebase_paths": {
          "type": "array",
          "items": { "type": "string" },
          "default": [],
          "description": "Codebase paths the agent should know"
        },
        "documentation": {
          "type": "array",
          "items": { "type": "string" },
          "default": [],
          "description": "Documentation references"
        },
        "external_resources": {
          "type": "array",
          "items": { "type": "string" },
          "default": [],
          "description": "External resources (URLs, specs, etc.)"
        }
      },
      "description": "Knowledge the new agent needs"
    },
    "tool_requirements": {
      "type": "object",
      "properties": {
        "existing_tools": {
          "type": "array",
          "items": { "type": "string" },
          "default": [],
          "description": "IDs of existing tools to assign"
        },
        "new_tools_needed": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "description"],
            "properties": {
              "name": { "type": "string" },
              "description": { "type": "string" },
              "operations": {
                "type": "array",
                "items": { "type": "string" }
              }
            }
          },
          "default": [],
          "description": "New tools that need to be created"
        }
      },
      "description": "Tool requirements for the new agent"
    },
    "decision_types": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1,
      "description": "Types of decisions this agent will make"
    },
    "validation_queries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["query", "expected_behavior"],
        "properties": {
          "query": {
            "type": "string",
            "description": "Sample query to test the agent"
          },
          "expected_behavior": {
            "type": "string",
            "description": "How the agent should respond"
          }
        }
      },
      "minItems": 2,
      "description": "Sample queries to validate the new agent"
    },
    "requested_by": {
      "type": ["string", "null"],
      "default": null,
      "description": "Agent ID or user who requested this"
    },
    "priority": {
      "type": "string",
      "enum": ["low", "normal", "high"],
      "default": "normal",
      "description": "Priority of this teaching request"
    },
    "target_agent_id": {
      "type": ["string", "null"],
      "pattern": "^[a-z][a-z0-9_]*$",
      "default": null,
      "description": "Proposed agent ID (auto-generated if null)"
    },
    "estimated_complexity": {
      "type": ["string", "null"],
      "enum": ["SIMPLE", "MODERATE", "COMPLEX", null],
      "default": null,
      "description": "Estimated complexity of the new domain"
    }
  },
  "additionalProperties": false
}
