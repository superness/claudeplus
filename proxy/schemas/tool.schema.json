{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://claudeplus.dev/schemas/tool.schema.json",
  "title": "Tool Definition",
  "description": "Schema for Feature Owner System bespoke tool definitions",
  "type": "object",
  "required": ["tool_id", "name", "description", "operations"],
  "properties": {
    "tool_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$",
      "description": "Unique tool identifier in snake_case format"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "Human-readable name for the tool"
    },
    "description": {
      "type": "string",
      "minLength": 10,
      "description": "Description of what this tool does"
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/operation"
      },
      "description": "Available operations for this tool"
    },
    "domain": {
      "type": "string",
      "default": "general",
      "description": "Domain this tool belongs to"
    },
    "owner_access": {
      "type": "array",
      "items": { "type": "string" },
      "default": ["*"],
      "description": "Agent IDs that can use this tool, '*' for all"
    },
    "implementation": {
      "type": ["object", "null"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["mcp", "builtin", "external", "composite"],
          "description": "How the tool is implemented"
        },
        "endpoint": {
          "type": "string",
          "description": "API endpoint or MCP server"
        },
        "config": {
          "type": "object",
          "description": "Implementation-specific configuration"
        }
      },
      "default": null,
      "description": "Implementation details for the tool"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "default": "1.0.0",
      "description": "Tool version"
    },
    "deprecated": {
      "type": "boolean",
      "default": false,
      "description": "Whether this tool is deprecated"
    }
  },
  "definitions": {
    "operation": {
      "type": "object",
      "required": ["name", "description"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-zA-Z0-9_]*$",
          "description": "Operation identifier"
        },
        "description": {
          "type": "string",
          "minLength": 5,
          "description": "What this operation does"
        },
        "parameters": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/parameter"
          },
          "description": "Parameter definitions for this operation"
        },
        "returns": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": ["string", "number", "boolean", "object", "array", "null"],
              "description": "Return value type"
            },
            "description": {
              "type": "string",
              "description": "Description of return value"
            },
            "schema": {
              "type": "object",
              "description": "JSON Schema for complex return types"
            }
          },
          "description": "Return value specification"
        }
      }
    },
    "parameter": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["string", "number", "integer", "boolean", "object", "array"],
          "description": "Parameter type"
        },
        "description": {
          "type": "string",
          "description": "Parameter description"
        },
        "required": {
          "type": "boolean",
          "default": false,
          "description": "Whether this parameter is required"
        },
        "default": {
          "description": "Default value if not provided"
        },
        "enum": {
          "type": "array",
          "description": "Allowed values for this parameter"
        },
        "pattern": {
          "type": "string",
          "description": "Regex pattern for string validation"
        },
        "minimum": {
          "type": "number",
          "description": "Minimum value for numbers"
        },
        "maximum": {
          "type": "number",
          "description": "Maximum value for numbers"
        }
      }
    }
  },
  "additionalProperties": false
}
