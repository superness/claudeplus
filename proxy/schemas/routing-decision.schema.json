{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://claudeplus.dev/schemas/routing-decision.schema.json",
  "title": "Routing Decision",
  "description": "Schema for Product Maestro routing decision output",
  "type": "object",
  "required": ["request_id", "timestamp", "decision", "rationale"],
  "properties": {
    "request_id": {
      "type": "string",
      "minLength": 1,
      "description": "Unique identifier for the request being routed"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp when decision was made"
    },
    "decision": {
      "type": "string",
      "enum": ["handle_directly", "delegate_single", "delegate_multi", "create_new_agent", "request_clarification"],
      "description": "Type of routing decision"
    },
    "rationale": {
      "type": "string",
      "minLength": 10,
      "description": "Explanation for why this decision was made"
    },
    "target_owner": {
      "type": ["string", "null"],
      "default": null,
      "description": "Single owner ID for delegate_single decisions"
    },
    "target_owners": {
      "type": "array",
      "items": { "type": "string" },
      "default": [],
      "description": "Multiple owner IDs for delegate_multi decisions"
    },
    "delegations": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "prompt": {
            "type": "string",
            "description": "Specific prompt for this owner"
          },
          "context": {
            "type": "object",
            "description": "Additional context for this owner"
          },
          "priority": {
            "type": "string",
            "enum": ["low", "normal", "high"],
            "default": "normal"
          }
        }
      },
      "default": {},
      "description": "Per-owner delegation details keyed by owner ID"
    },
    "analysis": {
      "type": ["object", "null"],
      "properties": {
        "intent": {
          "type": "string",
          "description": "Extracted user intent"
        },
        "domains": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Domains identified in request"
        },
        "complexity": {
          "type": "string",
          "enum": ["simple", "moderate", "complex"],
          "description": "Estimated complexity level"
        },
        "keywords": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Key terms identified in request"
        }
      },
      "default": null,
      "description": "Analysis of the incoming request"
    },
    "confidence": {
      "type": ["number", "null"],
      "minimum": 0,
      "maximum": 1,
      "default": null,
      "description": "Confidence score for this decision (0-1)"
    },
    "domains_identified": {
      "type": "array",
      "items": { "type": "string" },
      "default": [],
      "description": "All domains found in the request"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "decision": { "const": "delegate_single" } }
      },
      "then": {
        "required": ["target_owner"],
        "properties": {
          "target_owner": { "type": "string", "minLength": 1 }
        }
      }
    },
    {
      "if": {
        "properties": { "decision": { "const": "delegate_multi" } }
      },
      "then": {
        "required": ["target_owners"],
        "properties": {
          "target_owners": { "type": "array", "minItems": 2 }
        }
      }
    }
  ],
  "additionalProperties": false
}
